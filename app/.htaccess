# Settings for cPanel / Apache hosting. Other hosts ignore this file.

# Open the new home page first, even if an old WordPress index.php is still in the folder
DirectoryIndex index.html index.php

# Show the site's own page for addresses that don't exist
ErrorDocument 404 /404.html

# Don't list folder contents
Options -Indexes

# Send text files compressed so the site loads faster
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

# Let browsers keep images, styles and scripts for a while
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
